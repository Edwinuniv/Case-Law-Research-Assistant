# Database (local: the Docker container from docker-compose.yml)
DATABASE_URL=postgresql://verdicta:verdicta@localhost:5432/verdicta
TEST_DATABASE_URL=postgresql://verdicta:verdicta@localhost:5432/verdicta_test
# Language model (any OpenAI-compatible provider)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=paste-your-key-here
LLM_MODEL=llama-3.3-70b-versatile
# Website
SESSION_SECRET=any-long-random-text-without-spaces
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=choose-a-strong-password
