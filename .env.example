# Database (local: the Docker container from docker-compose.yml)
DATABASE_URL=postgresql://verdicta:verdicta@localhost:5432/verdicta
TEST_DATABASE_URL=postgresql://verdicta:verdicta@localhost:5432/verdicta_test
# Language model (any OpenAI-compatible provider)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=paste-your-key-here
LLM_MODEL=openai/gpt-oss-120b
# Website
SESSION_SECRET=any-long-random-text-without-spaces
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=choose-a-strong-password
CONTACT_EMAIL=                 # Contact page: one or more addresses separated by commas (the whole team); empty: none shown
GOOGLE_CLIENT_ID=              # Sign in with Google: the OAuth client id (public, ends in .apps.googleusercontent.com); empty: no Google button
PUBLIC_URL=http://127.0.0.1:8000   # the site's own address, used in the forgot-password links (online: https://...railway.app)
GMAIL_CLIENT_ID=               # Emails from verdicta.team@gmail.com through the Gmail API (README, "Emails"): Desktop OAuth client id
GMAIL_CLIENT_SECRET=           # ... its secret
GMAIL_REFRESH_TOKEN=           # made once with python -m scripts.gmail_token (secret); empty + no SMTP: emails printed locally only
SMTP_USER=                     # on a laptop instead of the API: verdicta.team@gmail.com
SMTP_PASSWORD=                 # ... and a Gmail app password (not the account's password)
EMAIL_VERIFICATION=1           # 1: new password accounts verify their email with a 6-digit code; 0: off
STRIPE_SECRET_KEY=             # Paid plan, Stripe TEST mode only: sk_test_... or a restricted rk_test_... (a live key is refused); empty: payments off
STRIPE_PRICE_ID=               # the monthly price made in the Stripe dashboard (test mode): price_...
STRIPE_WEBHOOK_SECRET=         # optional: whsec_... of the webhook endpoint /api/billing/webhook
PAID_PRICE_LABEL=              # what the pricing page shows (empty: $15 a month, the Stripe test price)
SITE_URL=                      # optional: where Stripe sends people back, e.g. https://...railway.app (empty: this site)
